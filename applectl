#!/usr/bin/env python3
import argparse, fcntl, json, os, sys, getpass, pwd, subprocess, signal

# Re-exec as root if not already (uses NOPASSWD sudoers rule)
if os.geteuid() != 0:
    os.execvp("sudo", ["sudo"] + sys.argv)

PHYSICAL_CORES = list(range(8))
LOGICAL_MAP = {p: [p, p + 8] for p in PHYSICAL_CORES}
TOTAL_LOGICAL = list(range(16))
JSON_FILE = "/etc/nixos/sandbox-config.json"
NIX_FILE  = "/etc/nixos/sandbox-config.nix"
LOCK_DIR  = "/run/applectl-sandbox"

def get_actual_user():
    """Get the actual user who ran the command (not root)"""
    user = os.environ.get('SUDO_USER')
    if user:
        return user
    sudo_uid = os.environ.get('SUDO_UID')
    if sudo_uid:
        try:
            return pwd.getpwuid(int(sudo_uid)).pw_name
        except (ValueError, KeyError):
            pass
    return getpass.getuser()

def load_config():
    try:
        data = json.load(open(JSON_FILE))
    except FileNotFoundError:
        return {}
    # Detect old per-user format ({"user": [...]}) and treat as empty
    if data and "cores" not in data:
        return {}
    return data

def save_config(config):
    with open(JSON_FILE, "w") as f:
        json.dump(config, f, indent=2)

def get_all_users():
    return sorted(
        u.pw_name
        for u in pwd.getpwall()
        if 1000 <= u.pw_uid < 2000
    )

def generate_nix(config):
    sandbox_cores = config.get("cores", [])
    sandbox_phys = set(sandbox_cores)
    normal_phys = sorted(p for p in PHYSICAL_CORES if p not in sandbox_phys)

    all_logical_str = ",".join(map(str, TOTAL_LOGICAL))
    normal_logical = sorted(l for p in normal_phys for l in LOGICAL_MAP[p])
    normal_str = ",".join(map(str, normal_logical))

    lines = [
        "{ lib, config, pkgs, ... }:",
        "{",
        f'  systemd.slices.system.sliceConfig = {{',
        f'    AllowedCPUs = "{normal_str}";',
        "  };",
        # user.slice always gets ALL cores so it never changes between rebuilds.
        # Changing user.slice causes systemd to restart it, killing every session.
        f'  systemd.slices.user.sliceConfig = {{',
        f'    AllowedCPUs = "{all_logical_str}";',
        "  };",
    ]

    # Per-user slices restrict individual users to non-sandbox cores.
    # Changing these is non-destructive (no session restarts).
    for user in get_all_users():
        uid = pwd.getpwnam(user).pw_uid
        lines += [
            f'  # User: {user} (UID: {uid})',
            f'  systemd.slices."user-{uid}".sliceConfig = {{',
            f'    AllowedCPUs = "{normal_str}";',
            "  };",
        ]

    if sandbox_cores:
        sandbox_logical = sorted(l for p in sandbox_cores for l in LOGICAL_MAP[p])
        sandbox_str = ",".join(map(str, sandbox_logical))
        lines += [
            f'  systemd.slices.benchmark.sliceConfig = {{',
            f'    AllowedCPUs = "{sandbox_str}";',
            "  };",
        ]

    lines.append("}")
    with open(NIX_FILE, "w") as f:
        f.write("\n".join(lines) + "\n")

def rebuild_nixos():
    """Execute nixos-rebuild switch and handle errors"""
    try:
        result = subprocess.run(
            ["nixos-rebuild", "switch"],
            capture_output=True,
            text=True,
            check=True
        )
        return True
    except subprocess.CalledProcessError as e:
        print(f"Failed to apply NixOS configuration:")
        print(f"Exit code: {e.returncode}")
        if e.stdout:
            print(f"stdout: {e.stdout}")
        if e.stderr:
            print(f"stderr: {e.stderr}")
        print("\nPlease reach out to #Cong Ma for assistance.")
        return False
    except Exception as e:
        print(f"Unexpected error during NixOS rebuild: {e}")
        print("Please reach out to #Cong Ma for assistance.")
        return False

def _boost_on_internal(silent=False):
    """Enable CPU boost"""
    try:
        with open("/sys/devices/system/cpu/cpufreq/boost", "w") as f:
            f.write("1")
        if not silent:
            print("Enabled CPU boost")
        return True
    except Exception as e:
        print(f"Failed to enable CPU boost: {e}")
        return False

def _boost_off_internal(silent=False):
    """Disable CPU boost"""
    try:
        with open("/sys/devices/system/cpu/cpufreq/boost", "w") as f:
            f.write("0")
        if not silent:
            print("Disabled CPU boost")
        return True
    except Exception as e:
        print(f"Failed to disable CPU boost: {e}")
        return False

def _get_boost_status():
    """Get current boost status (returns '1' for enabled, '0' for disabled)"""
    try:
        with open("/sys/devices/system/cpu/cpufreq/boost") as f:
            return f.read().strip()
    except Exception:
        return "1"  # Default to enabled if we can't read

def boost_on():
    return _boost_on_internal()

def boost_off():
    return _boost_off_internal()

def boost_status():
    try:
        status = _get_boost_status()
        if status == "1":
            print("CPU boost is enabled")
        else:
            print("CPU boost is disabled")
        return True
    except Exception as e:
        print(f"Failed to check CPU boost status: {e}")
        return False

# --- Core metadata helpers ---

def _core_lock_path(phys_core):
    return os.path.join(LOCK_DIR, f"core-{phys_core}.lock")

def _core_meta_path(phys_core):
    return os.path.join(LOCK_DIR, f"core-{phys_core}.json")

def _read_core_meta(phys_core):
    """Read metadata for a sandbox core. Returns dict or None."""
    try:
        with open(_core_meta_path(phys_core)) as f:
            return json.load(f)
    except (FileNotFoundError, json.JSONDecodeError):
        return None

def _write_core_meta(phys_core, user, pid, command):
    """Write metadata for a sandbox core."""
    with open(_core_meta_path(phys_core), "w") as f:
        json.dump({"user": user, "pid": pid, "command": command}, f)

def _remove_core_meta(phys_core):
    """Remove metadata for a sandbox core."""
    try:
        os.unlink(_core_meta_path(phys_core))
    except FileNotFoundError:
        pass

def _is_core_locked(phys_core):
    """Check if a core's lock file is held. Returns True if locked (in use)."""
    path = _core_lock_path(phys_core)
    try:
        fd = os.open(path, os.O_RDWR | os.O_CREAT)
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            # Got the lock — core is free. Release it.
            fcntl.flock(fd, fcntl.LOCK_UN)
            return False
        except (OSError, IOError):
            return True
        finally:
            os.close(fd)
    except OSError:
        return False

# --- Sandbox commands ---

def sandbox_set(cpus):
    """Set the sandbox to exactly `cpus` physical cores (0 = tear down)."""
    if cpus < 0:
        print("CPU count cannot be negative")
        sys.exit(1)

    if cpus >= len(PHYSICAL_CORES):
        print(f"Must leave at least 1 core for the system (max {len(PHYSICAL_CORES) - 1})")
        sys.exit(1)

    config = load_config()
    current_cores = set(config.get("cores", []))
    desired_cores = set(PHYSICAL_CORES[-cpus:]) if cpus > 0 else set()

    if desired_cores == current_cores:
        if cpus == 0:
            print("Sandbox is already down")
        else:
            print(f"Sandbox already has {cpus} cores: {sorted(current_cores)}")
        return

    # Cores being released must not have active bench jobs
    releasing = current_cores - desired_cores
    if releasing:
        active = []
        for core in sorted(releasing):
            if _is_core_locked(core):
                meta = _read_core_meta(core)
                if meta:
                    active.append((core, meta))
                else:
                    active.append((core, {"user": "unknown", "pid": "?", "command": "?"}))
        if active:
            print("Cannot release cores — bench jobs are still running:")
            for core, meta in active:
                print(f"  core {core}: user={meta['user']} pid={meta['pid']} cmd={meta['command']}")
            sys.exit(1)

    print("This operation will take ~30 seconds to complete")

    new_config = {"cores": sorted(desired_cores)} if desired_cores else {}
    generate_nix(new_config)
    if not rebuild_nixos():
        sys.exit(1)
    save_config(new_config)

    # Clean up lock/meta files for released cores
    for core in sorted(releasing):
        _remove_core_meta(core)
        try:
            os.unlink(_core_lock_path(core))
        except FileNotFoundError:
            pass

    if desired_cores:
        # Ensure lock dir and lock files exist for all sandbox cores
        os.makedirs(LOCK_DIR, exist_ok=True)
        for core in sorted(desired_cores):
            open(_core_lock_path(core), "a").close()
        print(f"Sandbox set to {cpus} cores: {sorted(desired_cores)}")
    else:
        # Tear down: remove lock dir if empty
        if os.path.isdir(LOCK_DIR):
            try:
                os.rmdir(LOCK_DIR)
            except OSError:
                pass
        print("Sandbox torn down — all cores released")

def sandbox_status():
    """Show sandbox status"""
    config = load_config()
    sandbox_cores = config.get("cores", [])

    if not sandbox_cores:
        print("Sandbox: DOWN")
        print(f"All {len(PHYSICAL_CORES)} physical cores available to the system")
        return

    normal_cores = sorted(p for p in PHYSICAL_CORES if p not in sandbox_cores)
    print("Sandbox: UP")
    print(f"Normal cores:  {normal_cores}")
    print(f"Sandbox cores: {sandbox_cores}")
    print()

    for core in sandbox_cores:
        if _is_core_locked(core):
            meta = _read_core_meta(core)
            if meta:
                print(f"  core {core}: IN USE  (user={meta['user']} pid={meta['pid']} cmd={meta['command']})")
            else:
                print(f"  core {core}: IN USE  (no metadata)")
        else:
            print(f"  core {core}: free")


class BenchRunner:
    """Manages the benchmark environment with proper cleanup."""

    def __init__(self):
        self.original_boost_status: str | None = None
        self.lock_fd: int | None = None
        self.phys_core: int | None = None
        self.cleanup_done = False

    def setup(self) -> bool:
        """Set up: find a free sandbox core, acquire its lock, disable boost."""
        config = load_config()
        sandbox_cores = config.get("cores", [])

        if not sandbox_cores:
            print("Sandbox is not up", file=sys.stderr)
            print("Set up a sandbox first with: applectl sandbox set --cpus N", file=sys.stderr)
            return False

        # Ensure lock dir exists (it's on tmpfs, so gone after reboot)
        os.makedirs(LOCK_DIR, exist_ok=True)

        # Try to acquire a free core
        for core in sandbox_cores:
            path = _core_lock_path(core)
            try:
                fd = os.open(path, os.O_RDWR | os.O_CREAT)
                try:
                    fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                    self.lock_fd = fd
                    self.phys_core = core
                    break
                except (OSError, IOError):
                    os.close(fd)
                    continue
            except OSError:
                continue

        if self.phys_core is None:
            print("All sandbox cores are in use — try again later", file=sys.stderr)
            return False

        # Write metadata
        user = get_actual_user()
        _write_core_meta(self.phys_core, user, os.getpid(), " ".join(sys.argv))

        # Save boost state and disable boost
        self.original_boost_status = _get_boost_status()
        _boost_off_internal(silent=True)

        logical = LOGICAL_MAP[self.phys_core][0]
        print(f"Acquired sandbox core {self.phys_core} (logical CPU {logical})")
        return True

    def cleanup(self) -> None:
        """Release lock, remove metadata, conditionally restore boost."""
        if self.cleanup_done:
            return
        self.cleanup_done = True

        if self.phys_core is not None:
            _remove_core_meta(self.phys_core)

        if self.lock_fd is not None:
            fcntl.flock(self.lock_fd, fcntl.LOCK_UN)
            os.close(self.lock_fd)
            self.lock_fd = None

        # Restore boost only if no other bench jobs are active
        if self.original_boost_status is not None and not self._any_bench_active():
            if self.original_boost_status == '1':
                _boost_on_internal(silent=True)
            else:
                _boost_off_internal(silent=True)

    def _any_bench_active(self) -> bool:
        """Check if any other sandbox cores are currently locked."""
        config = load_config()
        for core in config.get("cores", []):
            if core == self.phys_core:
                continue
            if _is_core_locked(core):
                return True
        return False

    def run_command(self, command: list[str]) -> int:
        """Run the benchmark command pinned to the sandbox core via systemd-run."""
        logical_cpu = LOGICAL_MAP[self.phys_core][0]
        user = get_actual_user()

        full_command = [
            "systemd-run",
            "--scope",
            "--slice=benchmark",
            f"--uid={user}",
            "--same-dir",
            "--quiet",
            "taskset", "-c", str(logical_cpu),
        ] + command

        try:
            result = subprocess.run(full_command)
            return result.returncode
        except KeyboardInterrupt:
            return 130


def bench_run(command: list[str]):
    """Run a benchmark command with CPU isolation and boost disabled."""
    if not command:
        print("No command specified", file=sys.stderr)
        sys.exit(1)

    runner = BenchRunner()
    exit_code = 1

    def signal_handler(signum, frame):
        runner.cleanup()
        sys.exit(128 + signum)

    original_sigint = signal.signal(signal.SIGINT, signal_handler)
    original_sigterm = signal.signal(signal.SIGTERM, signal_handler)

    try:
        if not runner.setup():
            sys.exit(1)
        exit_code = runner.run_command(command)
    except Exception as e:
        print(f"Error: {e}", file=sys.stderr)
        exit_code = 1
    finally:
        signal.signal(signal.SIGINT, original_sigint)
        signal.signal(signal.SIGTERM, original_sigterm)
        runner.cleanup()

    sys.exit(exit_code)


def main():
    p = argparse.ArgumentParser(prog="applectl")
    sp = p.add_subparsers(dest="cmd", required=True)

    # Boost commands
    boost_parser = sp.add_parser("boost")
    boost_sp = boost_parser.add_subparsers(dest="boost_cmd", required=True)
    boost_sp.add_parser("on")
    boost_sp.add_parser("off")
    boost_sp.add_parser("status")

    # Sandbox commands (with bench as a subcommand)
    sandbox_parser = sp.add_parser("sandbox")
    sandbox_sp = sandbox_parser.add_subparsers(dest="sandbox_cmd", required=True)
    sandbox_set_parser = sandbox_sp.add_parser("set", help="Set sandbox size (0 = tear down)")
    sandbox_set_parser.add_argument("--cpus", type=int, required=True)
    sandbox_sp.add_parser("status")
    bench_parser = sandbox_sp.add_parser("bench", help="Run a command in the sandbox")
    bench_parser.add_argument("command", nargs=argparse.REMAINDER,
                              help="Command to run")

    args = p.parse_args()

    if args.cmd == "boost":
        if args.boost_cmd == "on":
            boost_on()
        elif args.boost_cmd == "off":
            boost_off()
        elif args.boost_cmd == "status":
            boost_status()
        else:
            sys.exit(f"unknown boost command: {args.boost_cmd}")
    elif args.cmd == "sandbox":
        if args.sandbox_cmd == "set":
            sandbox_set(args.cpus)
        elif args.sandbox_cmd == "status":
            sandbox_status()
        elif args.sandbox_cmd == "bench":
            cmd = args.command
            # Strip leading '--' if present
            if cmd and cmd[0] == "--":
                cmd = cmd[1:]
            bench_run(cmd)
        else:
            sys.exit(f"unknown sandbox command: {args.sandbox_cmd}")
    else:
        sys.exit(f"unknown command: {args.cmd}")

if __name__ == "__main__":
    main()
